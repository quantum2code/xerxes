# Documentation only; copy selected settings into the server's trusted environment.
# Never put a raw authorization token in ENGINE2_GRANTS. Provision a SHA-256 hash.
ENGINE2_ENABLED=false
ENGINE2_ACTIVE_ENABLED=false
ENGINE2_GRANTS=[]
ENGINE2_ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
ENGINE2_GATEWAY_IMAGE=xerxes-engine2-gateway:local
ENGINE2_LAB_NETWORK=xerxes-engine2-lab
ENGINE2_LAB_TARGET=xerxes-engine2-fixture
ENGINE2_TOTAL_TIMEOUT_MS=180000
ENGINE2_STARTUP_TIMEOUT_MS=45000
ENGINE2_SPIDER_TIMEOUT_MS=45000
ENGINE2_PASSIVE_TIMEOUT_MS=30000
ENGINE2_ACTIVE_TIMEOUT_MS=60000
ENGINE2_MAX_REQUESTS=100
ENGINE2_REQUEST_INTERVAL_MS=250
ENGINE2_MAX_ACTIVE_ENDPOINTS=3
ENGINE2_MAX_CONCURRENT_SCANS=2
ENGINE2_PASSIVE_RULE_IDS=[]
# Empty passive rule list keeps ZAP's installed defaults. Default active rule IDs:
ENGINE2_POLICIES=[{"name":"conservative","ruleIds":["40012","40018","10028"],"strength":"LOW","threshold":"MEDIUM"}]

{
  "name": "server",
  "version": "1.0.0",
  "description": "Minimal web threat analysis pipeline server",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "ml:download": "tsx src/modules/threat-detection/ml-phishing/download-model.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "confusables": "^1.1.1",
    "express": "^5.1.0",
    "fastest-levenshtein": "^1.0.16",
    "ipaddr.js": "^2.5.0",
    "onnxruntime-node": "1.31.1",
    "tldts": "^7.4.19"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}

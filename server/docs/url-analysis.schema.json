{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xerxes:url-analysis:1.0",
  "title": "Xerxes URL Analysis",
  "type": "object", "additionalProperties": false,
  "required": ["module", "schemaVersion", "status", "input", "durationMs", "url", "dns", "http", "features", "errors", "limitations"],
  "properties": {
    "module": { "const": "urlAnalysis" }, "schemaVersion": { "const": "1.0" },
    "status": { "enum": ["completed", "partial", "blocked", "failed"] },
    "input": { "type": "string" }, "durationMs": { "$ref": "#/$defs/count" },
    "url": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/url" }] },
    "dns": { "$ref": "#/$defs/dns" }, "http": { "$ref": "#/$defs/http" },
    "features": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/features" }] },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "nullableString": { "type": ["string", "null"] },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["stage", "code", "message", "retryable"],
      "properties": {
        "stage": { "enum": ["input", "dns", "http", "analysis"] }, "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "message": { "type": "string" }, "retryable": { "type": "boolean" }, "recordType": { "enum": ["A", "AAAA", "CNAME", "MX", "NS", "TXT"] }
      }
    },
    "url": {
      "type": "object", "additionalProperties": false,
      "required": ["original", "normalized", "scheme", "hostname", "asciiHostname", "unicodeHostname", "port", "explicitPort", "path", "queryParameterNames", "queryParameterCount", "hasFragment", "domain", "publicSuffix", "subdomain", "domainLabels", "isIpAddress", "ipVersion"],
      "properties": {
        "original": { "type": "string" }, "normalized": { "type": "string" }, "scheme": { "enum": ["http", "https"] },
        "hostname": { "type": "string" }, "asciiHostname": { "type": "string" }, "unicodeHostname": { "type": "string" },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 }, "explicitPort": { "type": "boolean" }, "path": { "type": "string" },
        "queryParameterNames": { "type": "array", "items": { "type": "string" } }, "queryParameterCount": { "$ref": "#/$defs/count" }, "hasFragment": { "type": "boolean" },
        "domain": { "$ref": "#/$defs/nullableString" }, "publicSuffix": { "$ref": "#/$defs/nullableString" }, "subdomain": { "$ref": "#/$defs/nullableString" },
        "domainLabels": { "type": "array", "items": { "type": "string" } }, "isIpAddress": { "type": "boolean" }, "ipVersion": { "enum": [4, 6, null] }
      }
    },
    "network": {
      "type": "object", "additionalProperties": false, "required": ["address", "version", "category", "publiclyRoutable", "mappedIpv4"],
      "properties": { "address": { "type": "string" }, "version": { "enum": [4, 6] }, "category": { "type": "string" }, "publiclyRoutable": { "type": "boolean" }, "mappedIpv4": { "$ref": "#/$defs/nullableString" } }
    },
    "dnsAddress": {
      "type": "object", "additionalProperties": false, "required": ["address", "ttl", "network"],
      "properties": { "address": { "type": "string" }, "ttl": { "type": ["integer", "null"], "minimum": 0 }, "network": { "$ref": "#/$defs/network" } }
    },
    "query": {
      "type": "object", "additionalProperties": false, "required": ["status", "durationMs", "truncated"],
      "properties": { "status": { "enum": ["completed", "absent", "failed", "skipped"] }, "durationMs": { "$ref": "#/$defs/count" }, "truncated": { "type": "boolean" }, "error": { "$ref": "#/$defs/error" } }
    },
    "dns": {
      "type": "object", "additionalProperties": false, "required": ["status", "durationMs", "a", "aaaa", "cname", "mx", "ns", "txt", "queries", "errors"],
      "properties": {
        "status": { "enum": ["completed", "partial", "failed", "skipped"] }, "durationMs": { "$ref": "#/$defs/count" },
        "a": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/dnsAddress" } }, "aaaa": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/dnsAddress" } },
        "cname": { "type": "array", "maxItems": 128, "items": { "type": "string" } }, "ns": { "type": "array", "maxItems": 128, "items": { "type": "string" } },
        "mx": { "type": "array", "maxItems": 128, "items": { "type": "object", "additionalProperties": false, "required": ["exchange", "priority"], "properties": { "exchange": { "type": "string" }, "priority": { "$ref": "#/$defs/count" } } } },
        "txt": { "type": "array", "maxItems": 128, "items": { "type": "object", "additionalProperties": false, "required": ["segments", "byteLength", "kind"], "properties": {
          "segments": { "type": "array", "items": { "const": "[REDACTED TXT]" } }, "byteLength": { "$ref": "#/$defs/count" }, "kind": { "enum": ["spf", "dmarc", "dkim", "verification", "other"] }
        } } },
        "queries": { "type": "object", "additionalProperties": false, "required": ["A", "AAAA", "CNAME", "MX", "NS", "TXT"], "properties": {
          "A": { "$ref": "#/$defs/query" }, "AAAA": { "$ref": "#/$defs/query" }, "CNAME": { "$ref": "#/$defs/query" }, "MX": { "$ref": "#/$defs/query" }, "NS": { "$ref": "#/$defs/query" }, "TXT": { "$ref": "#/$defs/query" }
        } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
      }
    },
    "http": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "statusCode", "finalUrl", "method", "redirects", "redirectCount", "requestCount", "responseTimeMs", "contentType", "contentLength", "headers", "errors"],
      "properties": {
        "status": { "enum": ["completed", "failed", "blocked", "timed_out", "cancelled", "skipped"] }, "statusCode": { "type": ["integer", "null"], "minimum": 200, "maximum": 599 },
        "finalUrl": { "$ref": "#/$defs/nullableString" }, "method": { "enum": ["HEAD", "GET", null] },
        "redirects": { "type": "array", "maxItems": 11, "items": { "type": "object", "additionalProperties": false, "required": ["url", "statusCode", "target", "crossesRegistrableDomain", "followed"], "properties": {
          "url": { "type": "string" }, "statusCode": { "enum": [301, 302, 303, 307, 308] }, "target": { "type": "string" }, "crossesRegistrableDomain": { "type": ["boolean", "null"] }, "followed": { "type": "boolean" }
        } } },
        "redirectCount": { "$ref": "#/$defs/count" }, "requestCount": { "$ref": "#/$defs/count" }, "responseTimeMs": { "$ref": "#/$defs/count" },
        "contentType": { "$ref": "#/$defs/nullableString" }, "contentLength": { "type": ["integer", "null"], "minimum": 0 },
        "headers": { "type": "object", "additionalProperties": false, "properties": { "content-type": { "type": "string" }, "content-length": { "type": "string" }, "date": { "type": "string" }, "allow": { "type": "string" } } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
      }
    },
    "features": {
      "type": "object", "additionalProperties": false,
      "required": ["urlLength", "hostnameLength", "pathLength", "subdomainCount", "queryParameterCount", "dotCount", "hyphenCount", "digitCount", "specialCharacterCount", "hasIpAddress", "hasPunycode", "hasPercentEncoding", "unusualPort", "nonCanonicalIpv4", "repeatedSlashes", "repeatedEncoding", "embeddedUrlSyntax", "entropyBitsPerCharacter", "terms"],
      "properties": {
        "urlLength": { "$ref": "#/$defs/count" }, "hostnameLength": { "$ref": "#/$defs/count" }, "pathLength": { "$ref": "#/$defs/count" }, "subdomainCount": { "$ref": "#/$defs/count" }, "queryParameterCount": { "$ref": "#/$defs/count" },
        "dotCount": { "$ref": "#/$defs/count" }, "hyphenCount": { "$ref": "#/$defs/count" }, "digitCount": { "$ref": "#/$defs/count" }, "specialCharacterCount": { "$ref": "#/$defs/count" },
        "hasIpAddress": { "type": "boolean" }, "hasPunycode": { "type": "boolean" }, "hasPercentEncoding": { "type": "boolean" }, "unusualPort": { "type": "boolean" }, "nonCanonicalIpv4": { "type": "boolean" },
        "repeatedSlashes": { "type": "boolean" }, "repeatedEncoding": { "type": "boolean" }, "embeddedUrlSyntax": { "type": "boolean" }, "entropyBitsPerCharacter": { "type": "number", "minimum": 0 },
        "terms": { "type": "object", "additionalProperties": false, "required": ["login", "verify", "account", "secure", "update"], "properties": { "login": { "type": "boolean" }, "verify": { "type": "boolean" }, "account": { "type": "boolean" }, "secure": { "type": "boolean" }, "update": { "type": "boolean" } } }
      }
    }
  }
}

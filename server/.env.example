# Copy to server/.env; pnpm dev/start load it automatically. Exported variables take precedence.
PORT=3000
# Non-commercial use only. Enable Safe Browsing API and use a restricted server-side key.
# Without this variable, blacklist checks explicitly remain not_configured/unknown.
# GOOGLE_SAFE_BROWSING_API_KEY=your-server-side-key
# Optional: select 4 or 6 only if one address family has broken/slow routing to Google.
# GOOGLE_SAFE_BROWSING_ADDRESS_FAMILY=6
# Optional: use a different local copy of the pinned model.
# PHISHING_ONNX_MODEL_PATH=/srv/models/model.onnx
